{
    "name": "payisland/payisland-php",
    "description": "Official PHP SDK for integrating with PayIsland payment APIs.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "PayIsland\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PayIsland\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "vlucas/phpdotenv": "^5.0"
    },
    "scripts": {
        "test": "phpunit"
    }
}
